# Copie para .env e preencha. NAO comite o .env.

# --- Evolution ---
EVOLUTION_API_KEY=troque-por-uma-chave-longa-aleatoria
SERVER_URL=http://SEU_IP_DA_VPS:8080
WEBHOOK_URL=http://bot:3000/webhook

# Postgres (interno ao compose)
POSTGRES_PASSWORD=troque-tambem

# --- Bot ---
PORT=3000
EVOLUTION_URL=http://evolution:8080
INSTANCE_NAME=arlete
HUMAN_TTL_HOURS=18
MENU_RESET_HOURS=12
FOLLOWUP_HOURS=23
# USE_NATIVE_LIST=true -> tenta lista nativa do WhatsApp. HOJE quebra no Baileys da v2.3.7
# (ListMessage.toObject). Deixe false/ausente = menu numerado (robusto). So ligue se atualizar o Baileys.
USE_NATIVE_LIST=false

# DRY_RUN=true  -> nao chama o Evolution, so loga (use no teste local com o mock)
DRY_RUN=false

# --- Heartbeat (monitor externo na HostGator) ---
# Deixe HEARTBEAT_URL vazio pra desativar. Aponte pro heartbeat.php publicado na HostGator.
HEARTBEAT_URL=https://SEU_DOMINIO/bot-monitor/heartbeat.php
HEARTBEAT_SECRET=troque-por-um-segredo-igual-ao-do-php
HEARTBEAT_MIN=2
